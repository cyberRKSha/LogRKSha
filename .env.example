# Security
SECRET_KEY="your_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Infrastructure
RABBITMQ_HOST="localhost"
DASHBOARD_URL="http://127.0.0.1:8000"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
SESSION_TIMEOUT_SECONDS=3600

# Project Base Directory
LOG_FILES_STR=""
DATABASE_URL="postgresql://user:password@localhost/dbname"
LOG_DIR=""
MODEL_DIR=""
DATA_DIR=""
SIMULATION_DIR=""
STATIC_PATH=""
TEMPLATES_PATH=""
GEOIP_PATH=""
KNOWN_HASHES_FILE=""

# Integration API Keys
ABUSEIPDB_API_KEY=""
SLACK_WEBHOOK_URL=""
LOG_SHIPPER_API_KEY="dev_secret_key"

# PostgreSQL credentials
POSTGRES_DB=logAnomalyDB
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# RabbitMQ Docker credentials
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbit_password

# ML Pipeline
SEQUENCE_LEN=20


# LLM Providers (Add at least one)
# See LLM_SETUP.md for instructions
LLM_DEFAULT_PROVIDER="gemini"
LLM_CACHE_TTL=3600

# 1. Google Gemini (Recommended - Free Tier: 15 RPM)
GEMINI_API_KEY=""

# 2. Groq (Fastest - Free Tier: 30 RPM)
GROQ_API_KEY=""

# 3. Mistral AI (Free Tier available)
MISTRAL_API_KEY=""

# 4. OpenRouter (Aggregator)
OPENROUTER_API_KEY=""

# 5. Together AI
TOGETHER_API_KEY=""

# 6. Ollama (Local)
OLLAMA_HOST="http://localhost:11434"

# Environment
ENVIRONMENT="development"
